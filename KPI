<!DOCTYPE html>
<html lang="zh-TW">

<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>IE WIP Dashboard</title>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>

    body {
      font-family: Arial, sans-serif;
      max-width: 1100px;
      margin: 30px auto;
      padding: 20px;
    }

    h1 {
      margin-bottom: 25px;
    }

    .controls {
      margin-bottom: 20px;
    }

    select,
    button {
      font-size: 16px;
      padding: 8px 12px;
      margin-left: 5px;
    }

    button {
      cursor: pointer;
    }

    .cards {
      display: flex;
      gap: 20px;
      margin: 25px 0;
    }

    .card {
      flex: 1;
      padding: 20px;
      border: 1px solid #ccc;
      border-radius: 10px;
      text-align: center;
      background: #fafafa;
    }

    .card-title {
      font-size: 18px;
      color: #555;
      margin-bottom: 10px;
    }

    .value {
      font-size: 36px;
      font-weight: bold;
    }

    .material {
      color: #2563eb;
    }

    .product {
      color: #16a34a;
    }

    .status {
      margin: 10px 0;
      color: #666;
    }

    .chart-container {
      margin-top: 30px;
    }

    canvas {
      margin-top: 20px;
    }

    @media (max-width: 700px) {

      .cards {
        flex-direction: column;
      }

    }

  </style>

</head>


<body>

<h1>IE WIP Dashboard</h1>


<!-- ==========================
     Group 選擇
========================== -->

<div class="controls">

  Group：

  <select id="groupSelect">

    <option value="G01">G01</option>
    <option value="G02">G02</option>
    <option value="G03" selected>G03</option>
    <option value="G04">G04</option>
    <option value="G05">G05</option>
    <option value="G06">G06</option>
    <option value="G07">G07</option>
    <option value="G08">G08</option>
    <option value="G09">G09</option>
    <option value="G10">G10</option>
    <option value="G11">G11</option>
    <option value="G12">G12</option>

  </select>


  <button onclick="loadData()">
    立即更新
  </button>

</div>


<!-- ==========================
     KPI Cards
========================== -->

<div class="cards">


  <!-- Material WIP -->

  <div class="card">

    <div class="card-title">
      Material WIP
    </div>

    <div
      class="value material"
      id="materialWIP">

      -

    </div>

  </div>


  <!-- Product WIP -->

  <div class="card">

    <div class="card-title">
      Product WIP
    </div>

    <div
      class="value product"
      id="productWIP">

      -

    </div>

  </div>


</div>


<!-- ==========================
     更新時間
========================== -->

<div class="status">

  最後更新：

  <span id="lastUpdate">
    -
  </span>

</div>


<!-- ==========================
     Station Chart
========================== -->

<div class="chart-container">

  <h2>
    各工作站 WIP
  </h2>

  <canvas id="stationChart"></canvas>

</div>


<script>


// ==========================================
// Supabase 設定
// ==========================================

const SUPABASE_URL =
  "https://iomsrjkrvuzrsluirtdj.supabase.co";


const SUPABASE_KEY =
  "sb_publishable_QmLToEOs4wEEPBnASz0dxg_o0hhtgLO";


let stationChart = null;


// ==========================================
// 從 Supabase 讀取 Buffer
// ==========================================

async function loadData() {


  // 取得目前選擇的 Group

  const group =
    document
      .getElementById("groupSelect")
      .value;


  // ========================================
  // Supabase REST API
  // ========================================

  const url =
    SUPABASE_URL +
    "/rest/v1/buffer" +
    "?select=*" +
    "&group_id=eq." +
    encodeURIComponent(group);


  try {


    // ======================================
    // 呼叫 Supabase
    // ======================================

    const response =
      await fetch(
        url,
        {

          headers: {

            "apikey":
              SUPABASE_KEY,

            "Authorization":
              "Bearer " +
              SUPABASE_KEY

          }

        }
      );


    if (!response.ok) {

      throw new Error(
        "Supabase 讀取失敗：" +
        response.status
      );

    }


    const data =
      await response.json();


    console.log(
      "Buffer data:",
      data
    );


    // ======================================
    // 網頁端計算 KPI
    // ======================================

    calculateKPI(data);


    // ======================================
    // 畫 Station Chart
    // ======================================

    drawChart(data);


    // ======================================
    // 更新時間
    // ======================================

    document
      .getElementById("lastUpdate")
      .textContent =
      new Date()
        .toLocaleTimeString();


  }


  catch (error) {


    console.error(error);


    document
      .getElementById("materialWIP")
      .textContent =
      "ERROR";


    document
      .getElementById("productWIP")
      .textContent =
      "ERROR";

  }

}



// ==========================================
// 計算 Material / Product WIP
// ==========================================

function calculateKPI(data) {


  // ========================================
  // Material WIP
  // ========================================

  const materialWIP =
    data.reduce(

      (sum, row) =>

        sum +
        Number(
          row.material_buffer || 0
        ),

      0

    );


  // ========================================
  // Product WIP
  // ========================================

  const productWIP =
    data.reduce(

      (sum, row) =>

        sum +
        Number(
          row.product_buffer || 0
        ),

      0

    );


  // ========================================
  // 顯示
  // ========================================

  document
    .getElementById("materialWIP")
    .textContent =
    materialWIP.toLocaleString();


  document
    .getElementById("productWIP")
    .textContent =
    productWIP.toLocaleString();

}



// ==========================================
// Station WIP Chart
// ==========================================

function drawChart(data) {


  // ========================================
  // 建立 Station 資料
  // ========================================

  const stationData = {};


  data.forEach(row => {


    const station =
      row.station_id;


    const material =
      Number(
        row.material_buffer || 0
      );


    const product =
      Number(
        row.product_buffer || 0
      );


    // 如果 Station 尚未建立

    if (!stationData[station]) {

      stationData[station] = {

        material: 0,

        product: 0

      };

    }


    // Material

    stationData[station].material +=
      material;


    // Product

    stationData[station].product +=
      product;

  });



  // ========================================
  // Station 排序
  // ========================================

  const stations =
    Object.keys(stationData)
      .sort();



  // ========================================
  // Material 數據
  // ========================================

  const materialValues =
    stations.map(

      station =>
        stationData[station].material

    );



  // ========================================
  // Product 數據
  // ========================================

  const productValues =
    stations.map(

      station =>
        stationData[station].product

    );



  // ========================================
  // 如果之前有 Chart
  // 先刪掉
  // ========================================

  if (stationChart) {

    stationChart.destroy();

  }



  // ========================================
  // 建立 Chart
  // ========================================

  const ctx =
    document
      .getElementById(
        "stationChart"
      );


  stationChart =
    new Chart(

      ctx,

      {

        type: "bar",


        data: {

          labels:
            stations,


          datasets: [

            {

              label:
                "Material WIP",

              data:
                materialValues,

              backgroundColor:
                "#2563eb"

            },


            {

              label:
                "Product WIP",

              data:
                productValues,

              backgroundColor:
                "#16a34a"

            }

          ]

        },


        options: {

          responsive: true,


          scales: {

            y: {

              beginAtZero: true,

              title: {

                display: true,

                text: "WIP"

              }

            }

          }

        }

      }

    );

}



// ==========================================
// Group 改變
// ==========================================

document
  .getElementById(
    "groupSelect"
  )
  .addEventListener(
    "change",
    loadData
  );



// ==========================================
// 第一次開啟網頁
// ==========================================

loadData();



// ==========================================
// 每 10 秒自動更新
// ==========================================

setInterval(

  loadData,

  10000

);


</script>

</body>

</html>
